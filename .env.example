# 서버에서 이 파일을 .env로 복사해 값을 채운다. .env는 저장소에 올리지 않는다.
POSTGRES_PASSWORD=
# 서버에 연결한 도메인 (예: DuckDNS 서브도메인). Caddy가 HTTPS 인증서를 자동 발급한다.
DOMAIN=
# 공고 구조화에 쓰는 Gemini API 키 (서버에만 둔다)
GEMINI_API_KEY=
# 공공데이터포털 K-Startup 조회서비스 인증키
KSTARTUP_API_KEY=
# 고용24 OPEN-API 인증키 (개인 회원: 공채속보·채용행사)
WORK24_API_KEY=
# 관리자 아이디(쉼표 구분). 서버 현황을 볼 수 있는 계정
ADMIN_IDS=
